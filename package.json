{
  "name": "gusinje-vusanje-valley-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive destination guide for Gusinje, Vusanje and the Prokletije (Montenegro): 3D valley, map, places, local directory, travel tips and trip planner. Created and hosted by ROSI. Next.js static export.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve-static.mjs",
    "check:content": "playwright test --project=content",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:schema && npm run build && playwright test",
    "test:schema": "node backend/test-schema.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.3.7",
    "@playwright/test": "1.56.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  }
}
