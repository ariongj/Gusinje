# Copy to .env.local for local work, or set at build time on your host / in CI.

# Public origin of the site, no trailing slash — canonical URLs, sitemap, share
# links and QR codes. Defaults to https://ariongj.github.io/Gusinje.
NEXT_PUBLIC_SITE_URL=

# Sub-path the static export is served under (GitHub Pages: /<repo>). Empty for a domain root.
NEXT_PUBLIC_BASE_PATH=

# "true" on previews: noindex on every page and a robots.txt that disallows crawling.
NEXT_PUBLIC_NOINDEX=true

# Demo content (labelled sample businesses, events and illustrations — src/content/demo.ts).
# The preview turns it on; a public launch must leave it off.
NEXT_PUBLIC_DEMO=

# Map tiles. OpenStreetMap's standard tiles are fine for a low-traffic pilot;
# for a public launch use a provider with a plan that fits the traffic and set
# both values (the attribution is HTML and must name the data and tile sources).
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# 3D map: base map style (roads, trails, rivers, names) and elevation tiles.
# Defaults: OpenFreeMap "liberty" (OpenStreetMap data) and Mapzen terrain tiles on AWS Open Data.
NEXT_PUBLIC_MAP_STYLE=
NEXT_PUBLIC_MAP_TERRAIN=
