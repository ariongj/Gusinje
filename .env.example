# Copy to .env.local (local) or set in your host's dashboard (Vercel/Netlify).

# Public origin of the site — used for canonical URLs, the sitemap and structured data.
# Defaults to the GitHub Pages preview; set the real domain once the family has one.
NEXT_PUBLIC_SITE_URL=https://ariongj.github.io/hotelplav

# Where stay requests are sent as JSON (e.g. a Zapier/Make webhook that emails the
# family). Leave empty and the form offers to send each request by email instead —
# set this before launch.
ENQUIRY_WEBHOOK_URL=
